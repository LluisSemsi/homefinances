{% extends 'base/base.html.twig' %}

{% block title %}Detalles — {{ cuenta.getNombreBanco() }}{% endblock %}

{% block body %}

    {{ include('panel/templates/header.html.twig') }}
    {{ include('panel/templates/sidebar.html.twig') }}

    <main class="content">

        {# ============================================================ #}
        {# BREADCRUMB                                                    #}
        {# ============================================================ #}
        <nav class="breadcrumb-nav">
            <a href="{{ path('panel_home') }}" class="breadcrumb-link">Panel</a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">{{ cuenta.getNombreBanco() }} — {{ cuenta.getAlias() }}</span>
        </nav>

        {# ============================================================ #}
        {# CABECERA DE LA CUENTA                                         #}
        {# ============================================================ #}
        <div class="dc-header-card">
            <div class="dc-header-left">
                <img src="{{ asset('images/icons/' ~ cuenta.getImage()) }}" alt="Logo banco" class="dc-logo-banco">
                <div>
                    <span class="dc-label">Cuenta bancaria</span>
                    <h1 class="dc-titulo">{{ cuenta.getNombreBanco() }}</h1>
                    <div class="dc-meta">
                        <span class="dc-meta-item">{{ cuenta.getAlias() }}</span>
                        <span class="dc-meta-sep">·</span>
                        <span class="dc-meta-item dc-iban">{{ cuenta.getIBAN() }}</span>
                        <span class="dc-meta-sep">·</span>
                        <span class="dc-meta-item">Titular: <strong>{{ cuenta.getTitular() }}</strong></span>
                    </div>
                </div>
            </div>
            <div class="dc-header-right">
                <div class="dc-saldo-wrap">
                    <span class="dc-saldo-label">Saldo actual</span>
                    <span class="dc-saldo {{ cuenta.getSaldo() < 0 ? 'negative-number' : '' }}">
                        {{ cuenta.getSaldo()|number_format(2, ',', '.') }}€
                    </span>
                </div>
                <div class="dc-acciones-wrap">
                    <button class="dc-btn-acciones" onclick="toggleAcciones()">
                        Acciones
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 12 12"><path fill="#fff" d="M6 8L1 3h10z"/></svg>
                    </button>
                    <div class="dc-dropdown" id="dcDropdown">
                        <a href="{{ path('add-movimientos', { iban: cuenta.getIban() }) }}">➕ Añadir movimiento</a>
                        <a href="{{ path('categorizar-movimientos-bancarios', { iban: cuenta.getIban() }) }}">🏷️ Categorizar movimientos</a>
                        <a href="{{ path('bulk-movimientos-bancarios', { iban: cuenta.getIban() }) }}">📂 Importar desde fichero</a>
                        <a href="{{ path('editar-cuenta', { iban: cuenta.getIban() }) }}">✏️ Editar cuenta</a>
                        <div class="dc-dropdown-sep"></div>
                        <a href="{{ path('eliminar-cuenta', { iban: cuenta.getIban() }) }}" class="dc-dropdown-danger">🗑️ Eliminar cuenta</a>
                    </div>
                </div>
            </div>
        </div>

        {# ============================================================ #}
        {# GRÁFICOS                                                      #}
        {# ============================================================ #}
        <div class="dc-graficos-grid">
            <div class="card dc-grafico-card">
                <h3 class="dc-grafico-titulo">
                    Ingresos vs Gastos
                    <span class="dc-grafico-subtitulo">últimos 6 meses</span>
                </h3>
                <div id="graficoIngresosGastos"></div>
            </div>
            <div class="card dc-grafico-card">
                <h3 class="dc-grafico-titulo">
                    Gastos por categoría
                    <span class="dc-grafico-subtitulo">último mes</span>
                </h3>
                <div id="graficoGastosCategorias"></div>
            </div>
        </div>

        {# ============================================================ #}
        {# SECCIÓN MOVIMIENTOS                                           #}
        {# ============================================================ #}
        <div class="dc-movimientos-section">

            <div class="dc-movimientos-header">
                <h2 class="dc-movimientos-titulo">Movimientos</h2>
                <div class="filtros-container">
                    <div class="filtros-predefinidos">
                        <a href="{{ path('detalles-cuenta-bancaria', {iban: cuenta.getIban(), filtro: 'mes'}) }}"
                           class="btn-filtro {{ app.request.query.get('filtro') == 'mes' ? 'active' : '' }}">
                            Último mes
                        </a>
                        <a href="{{ path('detalles-cuenta-bancaria', {iban: cuenta.getIban(), filtro: 'trimestre'}) }}"
                           class="btn-filtro {{ app.request.query.get('filtro') == 'trimestre' ? 'active' : '' }}">
                            3 meses
                        </a>
                        <a href="{{ path('detalles-cuenta-bancaria', {iban: cuenta.getIban(), filtro: 'semestre'}) }}"
                           class="btn-filtro {{ app.request.query.get('filtro') == 'semestre' ? 'active' : '' }}">
                            6 meses
                        </a>
                        <a href="{{ path('detalles-cuenta-bancaria', {iban: cuenta.getIban(), filtro: 'anio'}) }}"
                           class="btn-filtro {{ app.request.query.get('filtro') == 'anio' ? 'active' : '' }}">
                            Último año
                        </a>
                    </div>
                    <form method="get" action="{{ path('detalles-cuenta-bancaria', {iban: cuenta.getIban()}) }}" class="filtros-fechas">
                        <input type="date" name="desde" value="{{ app.request.query.get('desde') }}">
                        <span class="filtros-hasta-label">hasta</span>
                        <input type="date" name="hasta" value="{{ app.request.query.get('hasta') }}">
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </form>
                </div>
            </div>

            <div class="dc-table-wrap card">
                <table class="dc-tabla">
                    <thead>
                        <tr class="dc-tabla-head">
                            <th class="dc-th dc-th-fecha">Fecha</th>
                            <th class="dc-th dc-th-concepto">Concepto</th>
                            <th class="dc-th dc-th-categoria">Categoría</th>
                            <th class="dc-th dc-th-cantidad">Cantidad</th>
                            <th class="dc-th dc-th-acciones"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if num_movimientos == 0 %}
                            <tr>
                                <td colspan="5" class="dc-tabla-empty">
                                    No hay movimientos para el período seleccionado.
                                </td>
                            </tr>
                        {% endif %}
                        {% for movimiento in movimientos %}
                            <tr class="dc-tabla-fila">
                                <td class="dc-td dc-td-fecha">
                                    {{ movimiento.getFecha()|date('d/m/Y') }}
                                </td>
                                <td class="dc-td dc-td-concepto">
                                    {{ movimiento.getConcepto() }}
                                </td>
                                <td class="dc-td dc-td-categoria">
                                    <span class="dc-categoria-chip">{{ movimiento.getTipo().getNombre() }}</span>
                                </td>
                                <td class="dc-td dc-td-cantidad {{ movimiento.getCantidad() < 0 ? 'negative-number' : 'positive-number' }}">
                                    {{ movimiento.getCantidad() >= 0 ? '+' : '' }}{{ movimiento.getCantidad()|number_format(2, ',', '.') }}€
                                </td>
                                <td class="dc-td dc-td-acciones">
                                    <button class="dc-btn-editar"
                                            title="Editar movimiento"
                                            onclick="abrirModal({{ movimiento.getId() }}, '{{ movimiento.getConcepto()|escape('js') }}', {{ movimiento.getTipo().getId() }})">
                                        <img src="{{ asset('images/icons/edit-icon.png') }}" alt="Editar" class="dc-edit-icon">
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="dc-tabla-footer">
                    {{ knp_pagination_render(movimientos) }}
                </div>
            </div>

        </div>

    </main>

    {# ============================================================ #}
    {# MODAL EDITAR MOVIMIENTO                                       #}
    {# ============================================================ #}
    <div id="modal-editar" class="modal-overlay" style="display:none">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Editar movimiento</h3>
                <button class="modal-close" onclick="cerrarModal()">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Concepto</label>
                    <input type="text" id="modal-concepto" class="modal-input">
                </div>
                <div class="form-group">
                    <label>Categoría</label>
                    <select id="modal-tipo">
                        {% for tipo in tipos %}
                            <option value="{{ tipo.getId() }}">{{ tipo.getNombre() }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancelar" onclick="cerrarModal()">Cancelar</button>
                <button class="btn btn-primary dc-modal-save" onclick="guardarMovimiento()">Guardar</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>

        /* ---- Dropdown acciones ---- */
        function toggleAcciones() {
            const dd = document.getElementById('dcDropdown');
            dd.style.display = dd.style.display === 'flex' ? 'none' : 'flex';
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dc-acciones-wrap')) {
                const dd = document.getElementById('dcDropdown');
                if (dd) dd.style.display = 'none';
            }
        });

        /* ---- Gráficos ---- */
        const ingresosGastos   = {{ ingresos_gastos|json_encode|raw }};
        const gastosCategorias = {{ gastos_categorias|json_encode|raw }};

        const meses = {
            '01': 'Ene', '02': 'Feb', '03': 'Mar', '04': 'Abr',
            '05': 'May', '06': 'Jun', '07': 'Jul', '08': 'Ago',
            '09': 'Sep', '10': 'Oct', '11': 'Nov', '12': 'Dic'
        };

        new ApexCharts(document.getElementById('graficoIngresosGastos'), {
            chart: { type: 'bar', height: 260, toolbar: { show: false }, fontFamily: 'inherit' },
            series: [
                { name: 'Ingresos', data: ingresosGastos.map(d => parseFloat(d.ingresos)) },
                { name: 'Gastos',   data: ingresosGastos.map(d => parseFloat(d.gastos)) }
            ],
            xaxis: {
                categories: ingresosGastos.map(d => meses[d.mes.split('-')[1]] + ' ' + d.mes.split('-')[0])
            },
            colors: ['#2196f3', '#1769aa'],
            plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
            dataLabels: { enabled: false },
            legend: { position: 'top' },
            yaxis: { labels: { formatter: val => val.toFixed(2) + '€' } },
            tooltip: { y: { formatter: val => val.toFixed(2) + '€' } },
            grid: { borderColor: '#f0f0f0' }
        }).render();

        new ApexCharts(document.getElementById('graficoGastosCategorias'), {
            chart: { type: 'donut', height: 260, fontFamily: 'inherit' },
            series: gastosCategorias.map(d => parseFloat(d.total)),
            labels:  gastosCategorias.map(d => d.categoria),
            colors: ['#2196f3', '#1769aa', '#64b5f6', '#0d47a1', '#42a5f5', '#1565c0', '#90caf9', '#0a3d7a'],
            dataLabels: { enabled: true, formatter: val => val.toFixed(1) + '%' },
            legend: { position: 'bottom' },
            tooltip: { y: { formatter: val => val.toFixed(2) + '€' } },
            plotOptions: {
                pie: {
                    donut: {
                        size: '65%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Total',
                                formatter: w => w.globals.seriesTotals.reduce((a, b) => a + b, 0).toFixed(2) + '€'
                            }
                        }
                    }
                }
            }
        }).render();

        /* ---- Modal ---- */
        let movimientoIdActual = null;

        function abrirModal(id, concepto, tipoId) {
            movimientoIdActual = id;
            document.getElementById('modal-concepto').value = concepto;
            document.getElementById('modal-tipo').value = tipoId;
            document.getElementById('modal-editar').style.display = 'flex';
        }

        function cerrarModal() {
            movimientoIdActual = null;
            document.getElementById('modal-editar').style.display = 'none';
        }

        function guardarMovimiento() {
            const concepto = document.getElementById('modal-concepto').value;
            const tipoId   = document.getElementById('modal-tipo').value;

            axios.post(`/panel/movimiento/editar/${movimientoIdActual}`, {
                concepto: concepto,
                tipo_id: parseInt(tipoId)
            })
            .then(() => {
                cerrarModal();
                mostrarNotificacion('Movimiento actualizado correctamente', 'success');
                setTimeout(() => location.reload(), 1500);
            })
            .catch(() => {
                mostrarNotificacion('Error al actualizar el movimiento', 'error');
            });
        }

        function mostrarNotificacion(mensaje, tipo) {
            const notif = document.createElement('div');
            notif.className = `notificacion ${tipo}`;
            notif.textContent = mensaje;
            document.body.appendChild(notif);
            setTimeout(() => notif.remove(), 3000);
        }

    </script>

{% endblock %}
