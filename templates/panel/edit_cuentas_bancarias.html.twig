{% extends 'base/base.html.twig' %}

{% block title %}Tu panel{% endblock %}

{% block body %}

    {{ include('panel/templates/header.html.twig') }}

    {{ include('panel/templates/sidebar.html.twig') }}

    <main class="content">

        <div id="edit-account-container">        
            <h1 class="titulo-panel titulo">Editar datos de una cuenta</h1>
            <p class="text-panel text">En este apartado puedes modificar los datos de una cuenta bancaria.</p>
            <div class="datos-cuenta">
                <div>
                    <img src="{{ asset('images/icons/' ~ cuenta.getImage()) }}" alt="Logo Banco" class="logo-banco">
                    <h2 class="subtitulo">{{ cuenta.getNombreBanco() }}</h2>
                    <p class="text"> - </p>
                    <p class="text">{{ cuenta.getAlias() }}</p>
                    <p class="text"> - </p>
                    <p class="text"><b>IBAN:</b> {{ cuenta.getIBAN() }}</p>                  
                </div>   
            </div>

            {{ form_errors(EditAccountForm) }}

            {{ form_start(EditAccountForm, { attr: {id: "form-create-bank-account"}}) }}
                {{ form_row(EditAccountForm.nombre_banco) }}
                {{ form_row(EditAccountForm.titular) }}
                {{ form_row(EditAccountForm.alias) }}

                <button type="submit" class="btn btn-primary">Editar cuenta</button>
            {{ form_end(EditAccountForm) }}
        </div>
        
    </main>

   

{% endblock %}
