{% extends 'base/base.html.twig' %}

{% block title %}Tus Inversiones{% endblock %}

{% block body %}

    {{ include('panel/templates/header.html.twig') }}

    {{ include('panel/templates/sidebar.html.twig') }}

    <main class="content">

        <h1 class="titulo-panel titulo">Inversiones</h1>
        <p class="text-panel text" id="text-inversiones">Resumen de tu portfolio de inversión</p>

        <div id="short-summary-container">
            <div class="card summary-card">
                <div>
                    <img src="{{ asset('images/icons/bank-accounts.png') }}" alt="Icono número de cuentas" class="panel-icon">
                </div>
                <div>
                    <h2>Capital Invertido</h2>
                    <p class="summary-data">{{capital_invertido}}€</p>
                </div>
            </div>
            <div class="card summary-card">
                <div>
                    <img src="{{ asset('images/icons/total-money.png') }}" alt="Icono saldo de cuentas" class="panel-icon">
                </div>
                <div>
                    <h2>Valor Actual</h2>
                    <p class="summary-data {{ valor_actual < 0 ? 'negative-number' : 'positive-number' }}">{{valor_actual}}€</p>
                </div>
            </div>
            <div class="card summary-card">
                <div>
                    <img src="{{ asset('images/icons/grafica.png') }}" alt="Icono saldo de cuentas" class="panel-icon">
                </div>
                <div>
                    <h2>Rentabilidad Total</h2>
                    <p class="summary-data {{ rentabilidad_absoluta < 0 ? 'negative-number' : 'positive-number' }}">
                        {{rentabilidad_absoluta}}€
                        <small id="percent-summary-invest" class="{{ rentabilidad_percent < 0 ? 'negative-number' : 'positive-number' }}">{{ rentabilidad_percent|round(2, 'floor') }}%</small>
                    </p>
                    

                </div>
            </div>
            <div class="card summary-card">
                <div>
                    <img src="{{ asset('images/icons/total-money.png') }}" alt="Icono saldo de cuentas" class="panel-icon">
                </div>
                <div>
                    <h2>Aportado este año</h2>
                    <p class="summary-data">{{aportado_anio}}€</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div id="grafico-inversiones-title-cont">
                <h2>Evolución del portfolio</h2>
                <p class="text">Capital invertido vs Valor actual</p>
            </div>
            <hr>
            <div id="grafico-evolucion"></div>
        </div>

        <div id="productos-inversion-container">
            <h2 class="titulo-seccion-inversiones">Tus productos de inversión</h2>

            {% for producto in productos %}
                {% set totalActual = producto.getTotalActualFondo() %}
                {% set totalInvertido = producto.getTotalInvertido() %}
                {% set rentabilidadAbs = totalActual - totalInvertido %}
                {% set rentabilidadPct = totalInvertido > 0 ? (rentabilidadAbs / totalInvertido) * 100 : 0 %}

                <div class="producto-card">

                    {# CABECERA DEL PRODUCTO #}
                    <div class="producto-header">
                        <div class="producto-header-info">
                            <span class="producto-label">Contrato</span>
                            <h3 class="producto-nombre">{{ producto.getNombre() }}</h3>
                            <span class="producto-contrato">Nº {{ producto.getNumContrato() }}</span>
                        </div>
                        <div class="producto-header-stats">
                            <div class="producto-stat">
                                <span class="stat-label">Valor actual</span>
                                <span class="stat-value">{{ totalActual|number_format(2, ',', '.') }}€</span>
                            </div>
                            <div class="producto-stat">
                                <span class="stat-label">Capital aportado</span>
                                <span class="stat-value">{{ totalInvertido|number_format(2, ',', '.') }}€</span>
                            </div>
                            <div class="producto-stat">
                                <span class="stat-label">Rentabilidad</span>
                                <span class="stat-value {{ rentabilidadAbs >= 0 ? 'positive-number' : 'negative-number' }}">
                                    {{ rentabilidadAbs >= 0 ? '+' : '' }}{{ rentabilidadAbs|number_format(2, ',', '.') }}€
                                    <small class="{{ rentabilidadPct >= 0 ? 'positive-number' : 'negative-number' }}">
                                        ({{ rentabilidadPct >= 0 ? '+' : '' }}{{ rentabilidadPct|number_format(2, ',', '.') }}%)
                                    </small>
                                </span>
                            </div>
                        </div>
                    </div>

                    {# FONDOS DEL PRODUCTO #}
                    <div class="fondos-grid">
                        {% for fondo in producto.getFondos() %}
                            {% set ultimoEstado = fondo.getUltimoEstado() %}
                            {% set fondoValorActual = ultimoEstado ? ultimoEstado.getValorActual() : 0 %}
                            {% set fondoImporteInvertido = ultimoEstado ? ultimoEstado.getImporteInvertido() : 0 %}
                            {% set fondoDiferencia = ultimoEstado ? ultimoEstado.getDiferenciaTotal() : 0 %}
                            {% set fondoDiferenciaPct = ultimoEstado ? ultimoEstado.getDiferenciaTotalPercent() : 0 %}

                            <div class="fondo-card">
                                <div class="fondo-header">
                                    <div class="fondo-isin-badge">{{ fondo.getIsin() }}</div>
                                    <span class="fondo-diferencia-badge {{ fondoDiferencia >= 0 ? 'badge-positive' : 'badge-negative' }}">
                                        {{ fondoDiferencia >= 0 ? '▲' : '▼' }}
                                        {{ fondoDiferenciaPct|number_format(2, ',', '.') }}%
                                    </span>
                                </div>
                                <p class="fondo-nombre">{{ fondo.getNombre() }}</p>
                                <div class="fondo-stats">
                                    <div class="fondo-stat-row">
                                        <span class="fondo-stat-label">Valor actual</span>
                                        <span class="fondo-stat-value">{{ fondoValorActual|number_format(2, ',', '.') }}€</span>
                                    </div>
                                    <div class="fondo-stat-row">
                                        <span class="fondo-stat-label">Aportado</span>
                                        <span class="fondo-stat-value">{{ fondoImporteInvertido|number_format(2, ',', '.') }}€</span>
                                    </div>
                                    <div class="fondo-stat-row">
                                        <span class="fondo-stat-label">Resultado</span>
                                        <span class="fondo-stat-value {{ fondoDiferencia >= 0 ? 'positive-number' : 'negative-number' }}">
                                            {{ fondoDiferencia >= 0 ? '+' : '' }}{{ fondoDiferencia|number_format(2, ',', '.') }}€
                                        </span>
                                    </div>
                                </div>

                                {% if ultimoEstado %}
                                    <div class="fondo-progress-bar">
                                        {% set pct = fondoImporteInvertido > 0 ? (fondoValorActual / fondoImporteInvertido * 100) : 100 %}
                                        <div class="progress-track">
                                            <div class="progress-fill {{ fondoDiferencia >= 0 ? 'progress-positive' : 'progress-negative' }}"
                                                style="width: {{ pct > 100 ? 100 : pct }}%"></div>
                                        </div>
                                        <span class="progress-label">{{ pct|number_format(1, ',', '.') }}% sobre aportado</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>

                    {# PIE DEL PRODUCTO #}
                    <div class="producto-footer">
                        <span class="producto-fecha">Abierto el {{ producto.getFechaApertura()|date('d/m/Y') }}</span>
                        <a href="{{ path('producto-inversion', { id: producto.getId() }) }}" class="btn-ver-mas">
                            Ver detalles completos →
                        </a>
                    </div>

                </div>
            {% else %}
                <div class="card" style="text-align:center; padding: 3rem;">
                    <p class="text">No tienes productos de inversión registrados.</p>
                </div>
            {% endfor %}
        </div>      

        
    </main>

    <!-- Apexcharts (Gráficos) -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>

        const datosGrafico = {{ datos_grafico|json_encode|raw }};

        new ApexCharts(document.getElementById('grafico-evolucion'), {
            chart: {
                type: 'line',
                height: 300,
                toolbar: { show: false },
                fontFamily: 'inherit'
            },
            series: [
                {
                    name: 'Valor actual',
                    data: datosGrafico.map(d => parseFloat(d.valor_actual))
                },
                {
                    name: 'Capital invertido',
                    data: datosGrafico.map(d => parseFloat(d.capital_invertido))
                }
            ],
            xaxis: {
                categories: datosGrafico.map(d => {
                    const fecha = new Date(d.fecha.date ?? d.fecha);
                    return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
                }),
                labels: { style: { fontSize: '11px' } }
            },
            colors: ['#2196f3', '#1769aa'],
            stroke: {
                curve: 'smooth',
                width: [2, 2],
                dashArray: [0, 4]
            },
            dataLabels: { enabled: false },
            legend: { position: 'top' },
            yaxis: {
                labels: {
                    formatter: val => val.toLocaleString('es-ES', { minimumFractionDigits: 2 }) + '€',
                    style: { fontSize: '11px' }
                }
            },
            tooltip: {
                y: {
                    formatter: val => val.toLocaleString('es-ES', { minimumFractionDigits: 2 }) + '€'
                }
            },
            grid: { borderColor: '#f0f0f0', strokeDashArray: 4 }
        }).render();    

    </script>
{% endblock %}
