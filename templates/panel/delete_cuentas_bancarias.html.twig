{% extends 'base/base.html.twig' %}

{% block title %}Tu panel{% endblock %}

{% block body %}

    {{ include('panel/templates/header.html.twig') }}

    {{ include('panel/templates/sidebar.html.twig') }}

    <main class="content">

       <div class="card card-borrar-cuenta">
        <h1 class="titulo-panel">Eliminar cuenta bancaria</h1>
            <p class="text-panel">La siguiente cuenta bancaria va a ser eliminada:</p>
            <p class="text-panel"><b>IBAN</b>: {{ cuenta_bancaria.getIBAN() }}</p>
            <p class="text-panel"><b>Nombre Banco</b>: {{ cuenta_bancaria.getNombreBanco() }}</p>

            <div class="cont-botones-horizontal">
                <a href="{{ path('home') }}"><button class="btn btn-cancel">Cancelar</button></a>
                <a href="{{ path('confirmar-eliminar-cuenta', { iban: cuenta_bancaria.iban }) }}"><button class="btn btn-success">Borrar Cuenta</button></a>
            </div>
       </div>   
        
    </main>

   

{% endblock %}
